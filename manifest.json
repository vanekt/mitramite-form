{
  "manifest_version": 3,
  "name": "Unofficial Mitramite Status Form",
  "version": "0.1.0",
  "description": "Unofficial: restores the trámite status lookup form on mitramite.renaper.gob.ar. Not affiliated with RENAPER.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mitramite.renaper.gob.ar/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
